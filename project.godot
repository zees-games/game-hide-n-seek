; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hide and Seek"
config/description="Hide and seek. One or two seekers count blindfolded while everybody else hides; then every hider they catch, by a touch, joins them. Hiders win if anybody is still hidden when the clock runs out."
run/main_scene="res://game/hs.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://branding/icon.png"
config/windows_native_icon="res://branding/icon.ico"
boot_splash/bg_color=Color(0.051, 0.0588, 0.0784, 1)
boot_splash/fullsize=true
boot_splash/image="res://branding/splash.png"
boot_splash/show_image=true
boot_splash/use_filter=true

[audio]

driver/enable_input=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gs_lighting/plugin.cfg")

[importer_defaults]

texture={
"detect_3d/compress_to": 0
}

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[gamespice]

perf_game_id="hide-n-seek"
